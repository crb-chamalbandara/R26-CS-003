{
  "name": "websentinel",
  "version": "1.0.0",
  "description": "WebSentinel — Browser Threat Detection Research Platform",
  "author": "WebSentinel Team (R26-CS-003)",
  "license": "UNLICENSED",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^27.3.11",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "lk.sliit.websentinel",
    "productName": "WebSentinel",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "../frontend",
        "to": "frontend"
      },
      {
        "from": "../dist/backend",
        "to": "backend"
      },
      {
        "from": "../dist/ms-playwright",
        "to": "ms-playwright"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": false,
      "artifactName": "WebSentinel-Setup-${version}.exe",
      "include": "installer/installer.nsh",
      "allowElevation": true
    }
  }
}
